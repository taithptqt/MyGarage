# Build
BUILD_CONFIGURATION=Release
NODE_OPTIONS=--max-old-space-size=2048

# Frontend (Vite)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_JWT_KEY_PROD=your_frontend_jwt_key

# Runtime
ASPNETCORE_ENVIRONMENT=Production
APP_PORT=80

# Backend secrets/config
Jwt__Key=your_backend_jwt_key
ConnectionStrings__GarageDbConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=MyGarage;Persist Security Info=False;Uid=your_user;Password=your_password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
EmailSettings__Password=your_email_app_password
LlmGateway__Providers__GEMINI_OPENAI__DefaultApiKey=your_gemini_api_key
GoogleAuth__ClientId=your_google_client_id

# PayOS
PayOS__ApiKey=your_payos_api_key
PayOS__ClientId=your_payos_client_id
PayOS__ChecksumKey=your_payos_checksum_key
PayOS__PayoutApiKey=your_payos_payout_api_key
PayOS__PayoutClientId=your_payos_payout_client_id
PayOS__PayoutChecksumKey=your_payos_payout_checksum_key
