{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "GarageDbConnection": "Server=tcp:YOUR_SQL_SERVER.database.windows.net,1433;Initial Catalog=MyGarage;Persist Security Info=False;Uid=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
    },
    "Jwt": {
        "Key": "YOUR_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_HMAC_SHA256",
        "Issuer": "MyGarageServer",
        "Audience": "MyGarageClients"
    },
    "GoogleAuth": {
        "ClientId": "202756204496-mo2j5g4ljm49kifuc5r43c0got31k2r1.apps.googleusercontent.com"
    },
    "Auth": {
        "PasswordResetUrlBase": "https://your-frontend-host/reset-password",
        "PasswordResetTokenExpiryMinutes": 15
    },
    "EmailSettings": {
        "SmtpServer": "smtp.gmail.com",
        "SmtpPort": 587,
        "SenderName": "MyGarage System",
        "SenderEmail": "mygaragefuda@gmail.com",
        "Password": "your-gmail-app-password"
    },
    "QuotationPortal": {
        "PublicBaseUrl": "http://localhost:5173/quote-access",
        "TokenExpiryDays": 15
    },
    "AzureStorage": {
        "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=YOUR_STORAGE_ACCOUNT_KEY==;EndpointSuffix=core.windows.net",
        "ContainerName": "uploads"
    }
,
    "AppointmentLifecycle": {
        "PreReminderMinutes": 30,
        "LateReminderMinutes": 10,
        "GoldenWarningMinutes": 15,
        "QuickFlowCancelMinutes": 15,
        "FlexibleFlowCancelMinutes": 30,
        "WeekendCancelMinutes": 15,
        "BranchOverrides": {
            "1": {
                "QuickFlowCancelMinutes": 15,
                "FlexibleFlowCancelMinutes": 30
            }
        }
    },
    "CustomerAutomationJobs": {
        "Enabled": true,
        "StartupDelaySeconds": 20,
        "LoopIntervalSeconds": 300,
        "Retry": {
            "MaxAttempts": 3,
            "BaseDelaySeconds": 5
        },
        "MaintenanceOutreach": {
            "Enabled": true,
            "BatchSize": 250,
            "LastCompletedServiceAgeDays": 180,
            "OdoDeltaThreshold": 5000,
            "ForecastLookaheadDays": 30,
            "CompletedServiceStatuses": [ "CLOSED", "READY", "COMPLETED", "DONE" ],
            "ForecastTypes": [ "MAINTENANCE", "SERVICE", "INSPECTION" ],
            "NotificationTitle": "Maintenance reminder"
        },
        "PostServiceSurvey": {
            "Enabled": true,
            "BatchSize": 250,
            "DelayHours": 24,
            "CompletedServiceStatuses": [ "CLOSED", "READY", "COMPLETED", "DONE" ],
            "NotificationTitle": "How was your service experience?"
        },
        "InsuranceExpiryReminder": {
            "Enabled": true,
            "BatchSize": 250,
            "ReminderWindowDays": 30,
            "NotificationTitle": "Insurance expiry reminder"
        },
        "ChatbotSessionCleanup": {
            "Enabled": true,
            "BatchSize": 500,
            "IdleToExpiredHours": 24,
            "ExpiredToArchivedDays": 30
        }
    },
    "LlmGateway": {
        "Enabled": true,
        "RequestTimeoutSeconds": 25,
        "MaxRetries": 2,
        "RetryBaseDelayMilliseconds": 400,
        "DefaultProvider": "GEMINI_OPENAI",
        "DefaultModel": "gemini-2.5-flash",
        "DefaultMaxTokens": 1200,
        "DefaultTemperature": 0.2,
        "Providers": {
            "GEMINI_OPENAI": {
                "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
                "DefaultApiKey": "YOUR_GEMINI_API_KEY"
            }
        }
    },
    "DiagnosisQueueScheduling": {
        "BranchDiagnoseBayCodes": {
            "1": [ "SP_D_HN1", "SP_D_HN2" ],
            "2": [ "SP_D_DN1", "SP_D_DN2" ],
            "3": [ "SP_D_HCM1", "SP_D_HCM2" ]
        }
    },
    "DiagnosisApprovalSla": {
        "TeamLeaderWarningMinutes": 15,
        "TeamLeaderEscalationMinutes": 30,
        "BranchOverrides": {
            "2": {
                "TeamLeaderWarningMinutes": 15,
                "TeamLeaderEscalationMinutes": 30
            }
        }
    }
}
