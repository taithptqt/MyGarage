{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PayOS": {
    "ClientId": "your-payos-client-id",
    "ApiKey": "your-payos-api-key",
    "ChecksumKey": "your-payos-checksum-key",
    "PayoutClientId": "",
    "PayoutApiKey": "",
    "PayoutChecksumKey": ""
  },
  "Auth": {
    "PasswordResetUrlBase": "http://localhost:5173/reset-password",
    "PasswordResetTokenExpiryMinutes": 15
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "MyGarage System",
    "SenderEmail": "mygaragefuda@gmail.com",
    "Password": "your-gmail-app-password"
  },
  "QuotationPortal": {
    "PublicBaseUrl": "http://localhost:5173/quote-access",
    "TokenExpiryDays": 15
  },
  "CustomerAutomationJobs": {
    "Enabled": true,
    "StartupDelaySeconds": 10,
    "LoopIntervalSeconds": 120,
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelaySeconds": 3
    },
    "MaintenanceOutreach": {
      "Enabled": true,
      "BatchSize": 100,
      "LastCompletedServiceAgeDays": 180,
      "OdoDeltaThreshold": 5000,
      "ForecastLookaheadDays": 30,
      "CompletedServiceStatuses": [ "CLOSED", "READY", "COMPLETED", "DONE" ],
      "ForecastTypes": [ "MAINTENANCE", "SERVICE", "INSPECTION" ],
      "NotificationTitle": "Maintenance reminder"
    },
    "PostServiceSurvey": {
      "Enabled": true,
      "BatchSize": 100,
      "DelayHours": 24,
      "CompletedServiceStatuses": [ "CLOSED", "READY", "COMPLETED", "DONE" ],
      "NotificationTitle": "How was your service experience?"
    },
    "InsuranceExpiryReminder": {
      "Enabled": true,
      "BatchSize": 100,
      "ReminderWindowDays": 30,
      "NotificationTitle": "Insurance expiry reminder"
    },
    "ChatbotSessionCleanup": {
      "Enabled": true,
      "BatchSize": 250,
      "IdleToExpiredHours": 24,
      "ExpiredToArchivedDays": 30
    }
  },
  "LlmGateway": {
    "Enabled": true,
    "RequestTimeoutSeconds": 20,
    "MaxRetries": 1,
    "RetryBaseDelayMilliseconds": 250,
    "Providers": {
      "OPENAI": {
        "BaseUrl": "https://api.openai.com"
      },
      "AZURE_OPENAI": {
        "BaseUrl": "https://your-azure-openai-resource.openai.azure.com",
        "ApiVersion": "2024-10-21"
      },
      "AZURE_OPENAI_VISION": {
        "BaseUrl": "https://your-azure-openai-resource.openai.azure.com",
        "ApiVersion": "2024-10-21"
      },
      "GEMINI_OPENAI": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "DefaultApiKey": "YOUR_GEMINI_API_KEY"
      }
    }
  },
  "DiagnosisQueueScheduling": {
    "BranchDiagnoseBayCodes": {
      "1": [ "SP_D_HN1", "SP_D_HN2" ],
      "2": [ "SP_D_DN1", "SP_D_DN2" ],
      "3": [ "SP_D_HCM1", "SP_D_HCM2" ]
    }
  },
  "DiagnosisApprovalSla": {
    "TeamLeaderWarningMinutes": 15,
    "TeamLeaderEscalationMinutes": 30,
    "BranchOverrides": {
      "2": {
        "TeamLeaderWarningMinutes": 15,
        "TeamLeaderEscalationMinutes": 30
      }
    }
  }
}
