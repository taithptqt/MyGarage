{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "GarageDbConnection": ""
    },
    "Jwt": {
        "Key": "",
        "Issuer": "MyGarageServer",
        "Audience": "MyGarageClients"
    },
    "GoogleAuth": {
        "ClientId": ""
    },
    "Auth": {
        "PasswordResetUrlBase": "https://REPLACE_WITH_YOUR_DOMAIN/reset-password",
        "PasswordResetTokenExpiryMinutes": 15
    },
    "EmailSettings": {
        "SmtpServer": "smtp.gmail.com",
        "SmtpPort": 587,
        "SenderName": "MyGarage System",
        "SenderEmail": "mygaragefuda@gmail.com",
        "Password": ""
    },
    "AzureStorage": {
        "ConnectionString": "",
        "ContainerName": "uploads"
    }
,
    "AppointmentLifecycle": {
        "PreReminderMinutes": 30,
        "LateReminderMinutes": 10,
        "GoldenWarningMinutes": 15,
        "QuickFlowCancelMinutes": 15,
        "FlexibleFlowCancelMinutes": 30,
        "WeekendCancelMinutes": 15,
        "BranchOverrides": {
            "1": {
                "QuickFlowCancelMinutes": 15,
                "FlexibleFlowCancelMinutes": 30
            }
        }
    },
    "CustomerAutomationJobs": {
        "Enabled": true,
        "StartupDelaySeconds": 20,
        "LoopIntervalSeconds": 300,
        "Retry": {
            "MaxAttempts": 3,
            "BaseDelaySeconds": 5
        },
        "MaintenanceOutreach": {
            "Enabled": true,
            "BatchSize": 250,
            "LastCompletedServiceAgeDays": 180,
            "OdoDeltaThreshold": 5000,
            "ForecastLookaheadDays": 30,
            "CompletedServiceStatuses": [ "CLOSED", "READY", "COMPLETED", "DONE" ],
            "ForecastTypes": [ "MAINTENANCE", "SERVICE", "INSPECTION" ],
            "NotificationTitle": "Maintenance reminder"
        },
        "PostServiceSurvey": {
            "Enabled": true,
            "BatchSize": 250,
            "DelayHours": 24,
            "CompletedServiceStatuses": [ "CLOSED", "READY", "COMPLETED", "DONE" ],
            "NotificationTitle": "How was your service experience?"
        },
        "InsuranceExpiryReminder": {
            "Enabled": true,
            "BatchSize": 250,
            "ReminderWindowDays": 30,
            "NotificationTitle": "Insurance expiry reminder"
        },
        "ChatbotSessionCleanup": {
            "Enabled": true,
            "BatchSize": 500,
            "IdleToExpiredHours": 24,
            "ExpiredToArchivedDays": 30
        }
    },
    "LlmGateway": {
        "Enabled": true,
        "RequestTimeoutSeconds": 25,
        "MaxRetries": 2,
        "RetryBaseDelayMilliseconds": 400,
        "DefaultProvider": "GEMINI_OPENAI",
        "DefaultModel": "gemini-2.5-flash",
        "DefaultMaxTokens": 1200,
        "DefaultTemperature": 0.2,
        "Providers": {
            "GEMINI_OPENAI": {
                "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
                "DefaultApiKey": ""
            }
        }
    },
    "Cors": {
        "AllowedOrigins": [
            "https://REPLACE_WITH_YOUR_DOMAIN"
        ]
    },
    "DiagnosisQueueScheduling": {
        "BranchDiagnoseBayCodes": {
            "1": [ "SP_D_HN1", "SP_D_HN2" ],
            "2": [ "SP_D_DN1", "SP_D_DN2" ],
            "3": [ "SP_D_HCM1", "SP_D_HCM2" ]
        }
    }
}
